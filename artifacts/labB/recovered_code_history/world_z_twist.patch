+def world_z_twist_joint_delta(q, angle_rad):
+    """Best-effort world-Z wrist twist with joint 6 held fixed."""
+    q = np.asarray(q, float)
+    solver = SingleArmIK(
+        str(MODEL),
+        joint_names=[f"left_arm_joint{i}" for i in range(1, 7)],
+        ee_frame="left_arm_ee",
+    )
+
+    def fk(active):
+        configuration = q.copy()
+        configuration[:5] = active
+        solver.update_configuration(configuration)
+        pose = solver.forward_kinematics()
+        wxyz = np.asarray(pose.rotation().wxyz, float)
+        rotation = Rotation.from_quat(np.r_[wxyz[1:], wxyz[0]])
+        return np.asarray(pose.translation(), float), rotation
+
+    solver.init(q)
+    position0, rotation0 = fk(q[:5])
+    target_rotation = Rotation.from_rotvec([0.0, 0.0, angle_rad]) * rotation0
+
+    def residual(active):
+        position, rotation = fk(active)
+        return np.r_[
+            (position - position0) / 0.003,
+            (rotation * target_rotation.inv()).as_rotvec() / 0.03,
+        ]
+
+    result = least_squares(
+        residual, q[:5], bounds=(q[:5] - 0.5, q[:5] + 0.5), max_nfev=400
+    )
+    target_position, target_rotation_actual = fk(result.x)
+    return (
+        np.r_[result.x - q[:5], 0.0],
+        (target_position - position0),
+        (target_rotation_actual * rotation0.inv()).as_rotvec(),
+    )
 
 
